# Keep the build context small and the image clean: only app/ + config.yaml +
# requirements.lock are COPYed. Everything else is dev-only or runtime state.
.git/
.github/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
docs/
data/
runs/
.env
.env.*
!.env.example
*.md
Dockerfile
.dockerignore
docker-compose.yml
