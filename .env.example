# data-prep environment — copy to .env and fill in. NEVER commit the real .env.
# Only secrets and machine-specific paths belong here; structured, non-secret
# operator config (LLM endpoints, budgets, api_v3 target) lives in config.yaml.

# --- Auth ---
# Operator API key for the UI and all data endpoints. Unset = auth DISABLED for
# LOOPBACK clients only; a request from a non-loopback address is then refused
# (403). Set a key for any remote/networked use. /health stays public either way.
DATAPREP_AUTH_KEY=change-me

# --- LLM ---
# OPTIONAL server-wide fallback key (the one config.yaml's llm.*.api_key_env
# points to, default OPENAI_API_KEY). Used for seed bootstrap, generation and
# enrichment WHEN a request carries no key of its own.
# Leave this UNSET to run an "open" instance: each user then supplies their own
# OpenAI key + model in the UI ("KI-Zugang" panel), sent per request as the
# X-LLM-Key / X-LLM-Model headers and never stored on the server.
# OPENAI_API_KEY=sk-...

# --- api_v3 push / label audit ---
# The key config.yaml's api_v3.api_key_env points to. Needs an admin key of the
# target api_v3 instance (dataset import + predict).
DATAPREP_APIV3_KEY=change-me

# --- Optional overrides (defaults shown) ---
# DATAPREP_LOG_LEVEL=INFO
# DATAPREP_UI_ENABLED=true
# DATAPREP_MAX_UPLOAD_MB=20
# Concurrent LLM calls per run (per-run overridable). Effective parallelism is
# min(this, number of selected concepts) — batches within a concept are sequential.
# DATAPREP_GENERATION_CONCURRENCY=20
# Guarded URL fetch (vocabularies): HTTPS-only allowlist, size cap, timeout.
# DATAPREP_FETCH_ALLOWED_HOSTS=vocabs.openeduhub.de
# DATAPREP_FETCH_MAX_MB=5
# DATAPREP_FETCH_TIMEOUT_SECONDS=20
# Storage paths (default to the package dir; override if data/runs live elsewhere).
# DATAPREP_DATA_DIR=./data
# DATAPREP_RUNS_DIR=./runs
# DATAPREP_CONFIG_FILE=./config.yaml

# Key for the OpenEduHub Bildungs-API gateway, used when an LLM purpose in
# config.yaml sets provider to b-api-openai or b-api-academiccloud. Sent as
# X-API-KEY, not as a bearer token.
#B_API_KEY=
